# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://dp:dp@localhost:5432/debatex

# --- AI provider: anthropic | openai | mock ---
# Leave LLM_PROVIDER empty to auto-detect from whichever key is set; with no key it falls back to the offline "mock" AI.
LLM_PROVIDER=ollama

GROQ_API_KEY=your_groq_api_key_here
# Optional overrides
LLM_MODEL=qwen2.5:3b

# For OpenAI-compatible services (OpenRouter, Groq, Ollama...), e.g. http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
PORT=3000
NODE_ENV=development
SEED_DEMO=true
